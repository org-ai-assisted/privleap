[Unit]
Description=privleap - Limited Privilege Escalation Framework
StartLimitIntervalSec=10
StartLimitBurst=3
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Conflicts=shutdown.target
Before=basic.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/privleapd
ExecReload=/usr/bin/leapctl --reload
WatchdogSec=10s
Restart=always

## W^X hardening (anonymous executable memory): MemoryDenyWriteExecute denies
## writable+executable anonymous mappings and any mmap/mprotect gaining
## PROT_EXEC; SystemCallFilter=~memfd_create blocks the anonymous memfd
## exec-bypass (the call is SIGSYS-killed). NoNewPrivileges stays FALSE on
## purpose: privleapd is root and escalates admin-defined actions
## (shim.py -> Popen) that may exec SUID helpers or otherwise gain privilege --
## the seccomp filter still installs via the root executor's CAP_SYS_ADMIN. That
## filter INHERITS into the escalated actions, so W^X covers them too (by design;
## none of the curated actions JIT). File-backed exec mappings are out of MDWE's
## scope (the AppArmor layer's job). privleapd and its deps never JIT (no ctypes
## callbacks / cffi / JIT).
MemoryDenyWriteExecute=true
SystemCallFilter=~memfd_create
NoNewPrivileges=false

## W^X Layer 2 (file-backed exec): privleapd's writable runtime state lives under
## /run (/run/privleapd). NoExecPaths marks /run non-executable in the unit mount
## namespace, closing the file-backed exec-mapping vector MDWE does not cover --
## per-daemon, no apparmor profile, independent of the remount-secure noexec
## toggle. /run holds sockets/state, never executables (the daemon and its
## escalated actions exec from /usr), and privleapd still rmtree+recreates its own
## /run/privleapd subdir normally -- NoExecPaths on the /run parent (not on
## /run/privleapd itself) avoids making that subdir a mount point.
NoExecPaths=/run

[Install]
WantedBy=multi-user.target
