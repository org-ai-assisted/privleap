[Unit]
Description=privleap - Limited Privilege Escalation Framework
StartLimitIntervalSec=10
StartLimitBurst=3
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target
Conflicts=shutdown.target
Before=basic.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/privleapd
ExecReload=/usr/bin/leapctl --reload
WatchdogSec=10s
Restart=always

## W^X hardening (Layer 1 anonymous + Layer 2 file-backed exec).
## - MemoryDenyWriteExecute: deny anonymous W+X mappings and mprotect/shmat that
##   gain PROT_EXEC.
## - SystemCallArchitectures=native: close the secondary-ABI (i386 ipc/mmap2)
##   bypass of MDWE's seccomp fallback.
## - LockPersonality: block the READ_IMPLIES_EXEC personality bypass.
## - SystemCallFilter=~memfd_create: kill the anonymous memfd exec-bypass (SIGSYS).
## - NoExecPaths: mark the common writable scratch dirs (/run,/tmp,/var/tmp,
##   /dev/shm,/dev -- /dev is rw+exec devtmpfs for root) non-executable, raising the bar on the file-backed
##   mmap(PROT_READ|PROT_EXEC) vector MDWE does not cover. PARTIAL for this ROOT
##   daemon: uid 0 could still exec a file written on another executable fs, or
##   clear noexec via mount_setattr -- a COMPLETE file-backed close would need a
##   dedicated AppArmor profile (out of scope here). It lists the /run,/tmp,...
##   PARENTS (not /run/privleapd) because privleapd rmtree+recreates its own state
##   subdir at startup; a per-dir mount breaks that.
## NoNewPrivileges stays FALSE: privleapd escalates admin actions (shim.py ->
## Popen) that may gain privilege; the seccomp still installs via the root
## executor's CAP_SYS_ADMIN. All of the above INHERIT into the escalated actions
## by design -- W^X covers them too. CAVEAT: SystemCallArchitectures=native and
## LockPersonality inherit as well, so a 32-bit admin-action binary or one that
## sets a READ_IMPLIES_EXEC personality would be REFUSED. None exist on modern
## amd64 Kicksecure; such a case fails loud (accepted, like the MDWE inheritance).
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LockPersonality=true
SystemCallFilter=~memfd_create
NoNewPrivileges=false
NoExecPaths=/run /tmp /var/tmp /dev/shm /dev

[Install]
WantedBy=multi-user.target
